{
    "manifest_version": 3,
    "name": "NetScope URL Queue",
    "description": "Saves the first ten Google result URLs in a Java queue.",
    "version": "1.0",
    "host_permissions": ["http://127.0.0.1:8766/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://*.google.com/search*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
